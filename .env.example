# NexusRAG Configuration — Complete Enterprise Knowledge Intelligence Platform

# LLM Configuration (Options: offline, gemini, openai)
LLM_PROVIDER=offline
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embedding Configuration (Options: local_dense, gemini, openai)
EMBEDDING_PROVIDER=local_dense
EMBEDDING_MODEL=models/text-embedding-004

# Vector DB & Storage
VECTOR_DB_PATH=nexusrag/data/vector_store
SQLITE_DB_PATH=nexusrag/data/nexusrag.db
GRAPH_DB_PATH=nexusrag/data/graph/knowledge_graph.json

# Hybrid Retrieval & Reranking
TOP_K=5
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
RERANKING_ENABLED=true
SIMILARITY_THRESHOLD=0.15

# Chunking Hyperparameters
CHUNK_SIZE=600
CHUNK_OVERLAP=120
