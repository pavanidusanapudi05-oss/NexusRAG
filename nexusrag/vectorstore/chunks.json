      "page_number": 1,
      "section_title": "Section 2. Working Hours & Attendance",
      "version": "1.0",
      "year": "2026",
      "department": "Enterprise Operations",
      "category": "Document",
      "file_path": "nexusrag\\data\\documents\\Employee_Operations_Policy_2025.pdf",
      "checksum": ""
    }
  },
